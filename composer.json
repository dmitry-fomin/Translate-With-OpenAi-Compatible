{
    "name": "dmitry/translator-llm",
    "description": "Book translator using OpenAI-compatible LLM (e.g. OpenAI, OpenRouter, closerouter)",
    "type": "project",
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "require": {
        "php": "^8.2",
        "symfony/console": "^7.0",
        "php-di/php-di": "^7.0",
        "guzzlehttp/guzzle": "^7.8",
        "ext-dom": "*",
        "ext-zip": "*",
        "vlucas/phpdotenv": "^5.6"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5",
        "phpstan/phpstan": "^1.11",
        "friendsofphp/php-cs-fixer": "^3.50"
    },
    "scripts": {
        "test": "phpunit",
        "stan": "phpstan analyse --memory-limit=512M",
        "fmt": "php-cs-fixer fix",
        "fmt:check": "php-cs-fixer fix --dry-run --diff",
        "check": [
            "@fmt:check",
            "@stan",
            "@test"
        ]
    }
}
