# --- LLM для перевода и саммаризации ---
# OpenAI-совместимый endpoint (api.openai.com, OpenRouter, closerouter и т.п.).
# Все значения обязательны. Без них приложение не стартует.
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_API_URL=
OPENAI_COMPATIBLE_MODEL=

# Язык перевода (используется в TRANSLATION_PROMPT.md).
TRANSLATION_TARGET_LANGUAGE=

# Творческая свобода LLM (0.0–2.0). 0.3 — близко к детерминизму; 0.7–0.9 — живее, но больше галлюцинаций.
TRANSLATION_TEMPERATURE=0.4
SUMMARY_TEMPERATURE=0.3

# Retry/backoff для LLM-запросов (429, 500, 502, 503, 504, ConnectException).
# Задержка = LLM_RETRY_BASE_DELAY_MS * (2 ** retry).
LLM_MAX_RETRIES=5
LLM_RETRY_BASE_DELAY_MS=1000

# Таймауты HTTP-запросов (секунды).
LLM_CONNECT_TIMEOUT=60
LLM_REQUEST_TIMEOUT=600
COVER_REQUEST_TIMEOUT=600

# Лимит токенов на ответ LLM (max_tokens). Опционально. Если пусто — параметр не отправляется,
# и провайдер сам решает (например, OpenRouter ставит размер контекстного окна модели,
# что может упереться в кредитный лимит → 402 Payment Required). Безопасный диапазон для
# перевода главы: 8000–16000. Должно быть положительным целым.
LLM_MAX_OUTPUT_TOKENS=32000

# --- Русификация обложки (флаг --cover) ---
# Image-edit модель через OpenAI-совместимый chat/completions endpoint
# (например, google/nano-banana-2-edit или openai/gpt-image-2-edit на closerouter).
COVER_API_KEY=
COVER_API_URL=
COVER_MODEL=
